{
  "name": "create-agent-stack",
  "version": "0.1.0",
  "description": "Progressively scaffold verified, agent-ready TypeScript projects.",
  "type": "module",
  "bin": {
    "create-agent-stack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run",
    "test:unit": "vitest run tests/generator.test.ts",
    "test:acceptance": "bun run build && vitest run tests/create-minimum-project.acceptance.test.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@types/node": "^22.15.30",
    "oxfmt": "^0.16.0",
    "oxlint": "^1.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
